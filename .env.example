# Local development uses this SQLite file when Turso settings are not provided.
DATA_DIR=./data

# Production on Vercel: set both values in Vercel Project Settings > Environment Variables.
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-a-Turso-database-token

# Optional but recommended: use a stable, long random secret for encrypting the saved AI provider key.
# If unset, TURSO_AUTH_TOKEN is used as the encryption secret.
CURRENT_DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret
